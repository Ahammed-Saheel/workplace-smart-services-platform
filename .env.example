# Database (SQLite file, zero-config for local MVP development)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs — change this in production.
# Generate one with: openssl rand -base64 32
JWT_SECRET="dev-only-secret-change-me-please-32chars-min"

# Base URL of the app (used for building links, e.g. in demo password reset flow)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
